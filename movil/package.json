    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-media-session": "^8.1.11",
    "@smithy/protocol-http": "^5.6.2",
